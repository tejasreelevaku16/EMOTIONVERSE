# Frontend environment variables (Vite exposed to client)
# Optional: Set when the API server is hosted separately (default is empty = same-origin /api)
VITE_API_BASE=

# Vercel Serverless Function Environment Variables (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# LLM_API_KEY=your_llm_api_key_here
